{
  "name": "project_saucelab_playwrightautomation_aiagents",
  "version": "1.0.0",
  "description": "This is a Playwright Automation framework of a sample Project \"sauce lab\" using playwright Typescript and Javascript using AI agents",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "testdata:build": "node utilities/createTestDataWorkbook.cjs && node utilities/excelToJson.cjs",
    "typecheck": "tsc --noEmit",
    "test:reports": "playwright test && allure generate allure-results --clean -o allure-report",
    "allure:generate": "allure generate allure-results --clean -o allure-report"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/poornimadevirengaraja/Project_SauceLab_PlaywrightAutomation_AIagents.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/poornimadevirengaraja/Project_SauceLab_PlaywrightAutomation_AIagents/issues"
  },
  "homepage": "https://github.com/poornimadevirengaraja/Project_SauceLab_PlaywrightAutomation_AIagents#readme",
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "allure-commandline": "^2.46.1",
    "allure-playwright": "^3.14.0",
    "dotenv": "^18.0.10",
    "exceljs": "^4.4.0"
  }
}
